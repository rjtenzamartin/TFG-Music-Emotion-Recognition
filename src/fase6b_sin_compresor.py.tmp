#!/usr/bin/env python3
"""
fase6b_sin_compresor.py -- Ablacion cuantitativa del compresor logaritmico
==========================================================================
TFG Reconocimiento de Emociones Musicales -- Ruben Jose Tenza Martin

OBJETIVO
--------
La Seccion 3.5 de la memoria justifica visualmente la compresion logaritmica
del espectrograma mel (Figura comparativa_compresor_log.png). Este script
ablata cuantitativamente esa decision: reentrena PANNs y AST sobre el
mismo split-0 oficial, pero sustituyendo AmplitudeToDB por la identidad
(es decir, alimentando el modelo con la energia mel en escala LINEAL).
La diferencia en ROC-AUC Macro y PR-AUC Macro frente a los modelos
canonicos de la Fase 4 cuantifica el beneficio numerico de la compresion.

DISENO EXPERIMENTAL
-------------------
* Dos condiciones por modelo:
    - canonico  : espectrograma log-mel (AmplitudeToDB con top_db=80)
    - sin_comp  : espectrograma mel sin compresion (escala lineal)
* Misma sample rate por modelo (32 kHz PANNs / 16 kHz AST).
* Mismo split-0 oficial. Misma seed. Mismos hiperparametros.
* Solo varia la activacion del modulo AmplitudeToDB.

USO
---
    cd TFG_Emociones/src
    python fase6b_sin_compresor.py --model panns
    python fase6b_sin_compresor.py --model ast
    python fase6b_sin_compresor.py --model both   # ejecuta ambos secuencialmente

SALIDAS (en resultados_finales/)
--------------------------------
* fase6b_resultados.csv     -- tabla con AUC/PR-AUC para canonico vs sin_comp
* fase6b_history_panns.csv  -- curva de aprendizaje sin_comp PANNs
* fase6b_history_ast.csv    -- curva de aprendizaje sin_comp AST
* fase6b_barras.png         -- comparativa visual canonico vs sin_comp
"""

from __future__ import annotations

import argparse
import math
import sys
import time
from pathlib import Path

import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import DataLoader

# Rutas y modulos del proyecto
SCRIPT_DIR   = Path(__file__).resolve().parent
PROJECT_ROOT = SCRIPT_DIR.parent
sys.path.insert(0, str(SCRIPT_DIR))

from dataset       import MTGJamendoDataset, load_split_tsv
from audio_utils   import AudioPreprocessor
from models_panns  import build_panns_model
from models_ast    import build_ast_model
from evaluacion_final import compute_all_metrics

SPLIT_DIR = PROJECT_ROOT / "mtg-jamendo-dataset" / "data" / "splits" / "split-0"
TRAIN_TSV = SPLIT_DIR / "autotagging_moodtheme-train.tsv"
VAL_TSV   = SPLIT_DIR / "autotagging_moodtheme-validation.tsv"
TEST_TSV  = SPLIT_DIR / "autotagging_moodtheme-test.tsv"

OUT_DIR = PROJECT_ROOT / "resultados_finales"
OUT_DIR.mkdir(exist_ok=True)

SEED   = 42
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"


# --------------------------------------------------------------------------
# Reproducibilidad
# --------------------------------------------------------------------------
def set_seed(seed: int = SEED) -> None:
    import os, random
    os.environ["PYTHONHASHSEED"]         = str(seed)
    os.environ["CUBLAS_WORKSPACE_CONFIG"] = ":4096:8"
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark     = False


# --------------------------------------------------------------------------
# Wrapper de AudioPreprocessor que desactiva la compresion logaritmica
# --------------------------------------------------------------------------
class LinearMelPreprocessor(AudioPreprocessor):
    """
    Variante del AudioPreprocessor canonico que sustituye AmplitudeToDB por
    una pasada lineal sobre el espectrograma mel. Todo lo demas (resampleo,
    fijacion a 30s, normalizacion de pico, parametros de FFT y banco mel)
    se mantiene identico para que la unica variable independiente sea la
    compresion.
    """

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.amplitude_to_db = nn.Identity()

    def to_logmel(self, waveform: torch.Tensor) -> torch.Tensor:
        """Espectrograma mel SIN compresion logaritmica."""
        mel = self.mel_extractor(waveform)
        return mel + 1e-9    # estabilidad numerica


# --------------------------------------------------------------------------
# Bucle de entrenamiento generico (PANNs / AST) con preproceso sin_comp
# --------------------------------------------------------------------------
def train_one_config(model_name: str, epochs: int = 10) -> dict:
    """Entrena un modelo en la variante 'sin_comp' y devuelve sus metricas."""
    set_seed(SEED)

    # Hiperparametros por modelo
    if model_name == "panns":
        target_sr   = 32000
        batch_size  = 16
        lr_max      = 2e-4
        accum_steps = 1
    elif model_name == "ast":
        target_sr   = 16000
        batch_size  = 2
        lr_max      = 5e-5
        accum_steps = 8
    else:
        raise ValueError(f"model_name desconocido: {model_name}")

    prep = LinearMelPreprocessor(target_sr=target_sr)

    df_train = load_split_tsv(TRAIN_TSV)
    df_val   = load_split_tsv(VAL_TSV)
    df_test  = load_split_tsv(TEST_TSV)

    ds_train = MTGJamendoDataset(df_train, prep, return_label=True)
    ds_val   = MTGJamendoDataset(df_val,   prep, return_label=True)
    ds_test  = MTGJamendoDataset(df_test,  prep, return_label=True)

    dl_train = DataLoader(ds_train, batch_size=batch_size, shuffle=True,
                          num_workers=8, pin_memory=True, drop_last=True)
    dl_val   = DataLoader(ds_val,   batch_size=batch_size, shuffle=False,
                          num_workers=8, pin_memory=True)
    dl_test  = DataLoader(ds_test,  batch_size=batch_size, shuffle=False,
                          num_workers=8, pin_memory=True)

    # Modelo
    if model_name == "panns":
        model = build_panns_model(num_classes=59).to(DEVICE)
    else:
        model = build_ast_model(num_classes=59).to(DEVICE)

    # Perdida con pos_weight
    pos_weight = ds_train.get_pos_weight().to(DEVICE)
    criterion  = nn.BCEWithLogitsLoss(pos_weight=pos_weight)

    optimizer = torch.optim.AdamW(model.parameters(), lr=lr_max, weight_decay=1e-4)
    total_steps_per_epoch = math.ceil(len(dl_train) / accum_steps)
    scheduler = torch.optim.lr_scheduler.OneCycleLR(
        optimizer, max_lr=lr_max,
        steps_per_epoch=total_steps_per_epoch, epochs=epochs,
        pct_start=0.3, anneal_strategy="cos",
    )

    history = []
    best_val_auc, best_state = -1.0, None

    for epoch in range(1, epochs + 1):
        model.train()
        train_losses = []
        optimizer.zero_grad(set_to_none=True)

        for step, (x, y) in enumerate(dl_train):
            x, y = x.to(DEVICE), y.to(DEVICE)
            with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
                logits = model(x)
                loss   = criterion(logits, y) / accum_steps
            loss.backward()
            train_losses.append(loss.item() * accum_steps)

            if (step + 1) % accum_steps == 0:
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
                optimizer.step()
                scheduler.step()
                optimizer.zero_grad(set_to_none=True)

        # Validacion
        model.eval()
        val_losses, y_true, y_score = [], [], []
        with torch.no_grad():
            for x, y in dl_val:
                x, y = x.to(DEVICE), y.to(DEVICE)
                with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
                    logits = model(x)
                    loss   = criterion(logits, y)
                val_losses.append(loss.item())
                y_true .append(y.float().cpu().numpy())
                y_score.append(torch.sigmoid(logits).float().cpu().numpy())

        y_true  = np.concatenate(y_true)
        y_score = np.concatenate(y_score)
        m = compute_all_metrics(y_true, y_score)

        record = {
            "epoch":      epoch,
            "train_loss": float(np.mean(train_losses)),
            "val_loss":   float(np.mean(val_losses)),
            "val_auc":    float(m["roc_auc_macro"]),
        }
        history.append(record)
        print(f"[{model_name}|sin_comp] epoch {epoch:2d} -- "
              f"train_loss={record['train_loss']:.4f}  "
              f"val_loss={record['val_loss']:.4f}  "
              f"val_auc={record['val_auc']:.4f}")

        if m["roc_auc_macro"] > best_val_auc:
            best_val_auc = m["roc_auc_macro"]
            best_state   = {k: v.detach().cpu().clone()
                            for k, v in model.state_dict().items()}

    # Evaluacion final sobre test con el mejor checkpoint
    if best_state is not None:
        model.load_state_dict(best_state)
    model.eval()
    y_true, y_score = [], []
    with torch.no_grad():
        for x, y in dl_test:
            x, y = x.to(DEVICE), y.to(DEVICE)
            with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
                logits = model(x)
            y_true .append(y.float().cpu().numpy())
            y_score.append(torch.sigmoid(logits).float().cpu().numpy())

    y_true  = np.concatenate(y_true)
    y_score = np.concatenate(y_score)
    final_metrics = compute_all_metrics(y_true, y_score)
    final_metrics["model"]        = model_name
    final_metrics["variant"]      = "sin_comp"
    final_metrics["best_val_auc"] = best_val_auc

    pd.DataFrame(history).to_csv(
        OUT_DIR / f"fase6b_history_{model_name}.csv", index=False)

    return final_metrics


# --------------------------------------------------------------------------
# Generacion de figuras y tabla agregada
# --------------------------------------------------------------------------
def export_tabla_y_figuras(resultados_sin: list[dict]) -> None:
    """Genera fase6b_resultados.csv y la figura de barras comparativa."""
    import matplotlib.pyplot as plt

    # Resultados canonicos de Fase 4
    df_fase4 = pd.read_csv(OUT_DIR / "fase4_resultados.csv")
    canonicos = {
        "panns": df_fase4.loc[df_fase4["Modelo"] == "PANNs CNN14"].iloc[0],
        "ast":   df_fase4.loc[df_fase4["Modelo"] == "AST Transformer"].iloc[0],
    }

    rows = []
    for r in resultados_sin:
        rows.append({
            "modelo":        r["model"],
            "variante":      "canonico (log-mel)",
            "roc_auc_macro": canonicos[r["model"]]["ROC-AUC Macro"],
            "pr_auc_macro":  canonicos[r["model"]]["PR-AUC Macro"],
        })
        rows.append({
            "modelo":        r["model"],
            "variante":      "sin_comp (mel lineal)",
            "roc_auc_macro": r["roc_auc_macro"],
            "pr_auc_macro":  r["pr_auc_macro"],
        })

    df_out = pd.DataFrame(rows)
    df_out.to_csv(OUT_DIR / "fase6b_resultados.csv", index=False)
    print(f"\nResultados guardados -> {OUT_DIR/'fase6b_resultados.csv'}")
    print(df_out)

    # Figura de barras
    fig, ax = plt.subplots(figsize=(8, 5))
    modelos = df_out["modelo"].unique()
    x = np.arange(len(modelos))
    width = 0.35

    canonico_auc = [df_out[(df_out["modelo"] == m) & (df_out["variante"].str.startswith("canonico"))]["roc_auc_macro"].iloc[0] for m in modelos]
    sincomp_auc  = [df_out[(df_out["modelo"] == m) & (df_out["variante"].str.startswith("sin_comp"))]["roc_auc_macro"].iloc[0] for m in modelos]

    ax.bar(x - width/2, canonico_auc, width, label="canonico (log-mel)", color="#1f4e79")
    ax.bar(x + width/2, sincomp_auc,  width, label="sin compresor (lineal)", color="#a00000")
    ax.axhline(y=0.725, linestyle="--", color="gray", label="baseline VGG-ish")
    ax.set_xticks(x)
    ax.set_xticklabels([m.upper() for m in modelos])
    ax.set_ylabel("ROC-AUC Macro (test)")
    ax.set_title("Fase 6B: ablacion del compresor logaritmico")
    ax.set_ylim(0.55, 0.78)
    ax.legend()
    ax.grid(True, alpha=0.3, axis="y")
    plt.tight_layout()
    plt.savefig(OUT_DIR / "fase6b_barras.png", dpi=130, bbox_inches="tight")
    print(f"Figura guardada      -> {OUT_DIR/'fase6b_barras.png'}")


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--model",  choices=["panns", "ast", "both"], default="both")
    parser.add_argument("--epochs", type=int, default=10)
    args = parser.parse_args()

    print(f"[Fase 6B] Ablacion del compresor logaritmico")
    print(f"          dispositivo = {DEVICE}")
    print(f"          modelo(s)   = {args.model}")
    print(f"          epochs      = {args.epochs}")

    resultados = []
    t0 = time.time()
    if args.model in ("panns", "both"):
        resultados.append(train_one_config("panns", epochs=args.epochs))
    if args.model in ("ast", "both"):
        resultados.append(train_one_config("ast",   epochs=args.epochs))

    export_tabla_y_figuras(resultados)
    print(f"\nFase 6B completada en {(time.time() - t0)/60:.1f} min")


if __name__ == "__main__":
    main()
